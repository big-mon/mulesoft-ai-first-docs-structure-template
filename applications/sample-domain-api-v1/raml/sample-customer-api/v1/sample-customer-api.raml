#%RAML 1.0
title: サンプル顧客API
version: v1
baseUri: https://api.example.com/api/v1
mediaType: application/json

annotationTypes:
  operationId:
    type: string

types:
  Customer: !include types/Customer.raml
  CustomerSearchRequest: !include types/CustomerSearchRequest.raml
  CustomerSearchResponse: !include types/CustomerSearchResponse.raml
  ErrorResponse: !include types/ErrorResponse.raml

traits:
  common-headers: !include traits/common-headers.raml
  common-errors: !include traits/common-errors.raml

/customers:
  /{customerId}:
    uriParameters:
      customerId:
        type: string
        required: true
        example: C000001
    get: !include resources/get_customer-get-by-id.raml

  /search:
    post: !include resources/post_customer-search.raml
