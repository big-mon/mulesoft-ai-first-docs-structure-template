#%RAML 1.0
title: サンプル顧客API
version: v1
baseUri: https://api.example.com/api/v1
mediaType: application/json

annotationTypes:
  operationId:
    type: string

types:
  Customer: !include types/Customer.raml
  CustomerSearchRequest: !include types/CustomerSearchRequest.raml
  CustomerSearchResponse: !include types/CustomerSearchResponse.raml
  ErrorResponse: !include ../../../common/raml/types/ErrorResponse.raml

traits:
  correlation-id: !include ../../../common/raml/traits/correlation-id.raml
  common-errors: !include ../../../common/raml/traits/common-errors.raml

/customers:
  /{customerId}:
    uriParameters:
      customerId:
        type: string
        required: true
        example: C000001
    get: !include ../operations/get-customer-by-id/get-customer-by-id.raml

  /search:
    post: !include ../operations/post-customer-search/post-customer-search.raml
