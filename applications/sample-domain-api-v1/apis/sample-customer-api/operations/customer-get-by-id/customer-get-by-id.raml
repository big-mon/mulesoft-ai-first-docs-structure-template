#%RAML 1.0 Method
(operationId): sample-customer-api-v1.customer.getById
displayName: 顧客取得
description: 顧客IDを指定して顧客情報を取得します。
is:
  - correlation-id
  - common-errors
responses:
  200:
    description: 顧客情報が見つかりました。
    body:
      application/json:
        type: Customer
        example: !include examples/customer-get-by-id-response.json
