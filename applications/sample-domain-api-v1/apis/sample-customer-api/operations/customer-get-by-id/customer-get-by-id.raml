#%RAML 1.0 Method
(operationId): sample-customer-api-v1.customer.getById
displayName: 顧客取得
description: |
  顧客IDを指定して顧客情報を取得します。
  client_id and client_secret headers are required by Client ID enforcement.
  customerId path parameterはroot RAMLのresourceで定義します。
is:
  - correlation-id
  - common-errors
headers:
  client_id:
    type: string
    required: true
    description: API ManagerのClient ID enforcementで検証するClient IDです。
    example: sample-client-id
  client_secret:
    type: string
    required: true
    description: API ManagerのClient ID enforcementで検証するClient Secretです。
    example: sample-client-secret
responses:
  200:
    description: 顧客情報が見つかりました。
    body:
      application/json:
        type: Customer
        example: !include examples/customer-get-by-id-response.json
