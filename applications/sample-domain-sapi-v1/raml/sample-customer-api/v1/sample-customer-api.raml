#%RAML 1.0
title: サンプル顧客API
version: v1
baseUri: https://api.example.com/api/v1
mediaType: application/json

annotationTypes:
  operationId:
    type: string

types:
  Customer: !include types/Customer.raml
  CustomerSearchRequest: !include types/CustomerSearchRequest.raml
  CustomerSearchResponse: !include types/CustomerSearchResponse.raml
  ErrorResponse: !include ../../common/types/ErrorResponse.raml

traits:
  correlation-id: !include ../../common/traits/correlation-id.raml
  client-id-required: !include ../../common/traits/client-id-required.raml
  common-errors: !include ../../common/traits/common-errors.raml

/customers:
  /{customerId}:
    uriParameters:
      customerId:
        type: string
        required: true
        example: C000001
    get: !include resources/get_customer-get-by-id.raml

  /search:
    post: !include resources/post_customer-search.raml
