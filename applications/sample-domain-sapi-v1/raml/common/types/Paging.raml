#%RAML 1.0 DataType
type: object
additionalProperties: false
properties:
  limit:
    type: integer
    required: true
    minimum: 1
    maximum: 100
    example: 20
  offset:
    type: integer
    required: true
    minimum: 0
    example: 0
  total:
    type: integer
    required: false
    minimum: 0
    example: 125
